@model TrackerFormViewModel
@{
    var meta = (TrackerMeta)ViewData["Meta"]!;
    var isBr = !meta.IsIncident;
    var editing = Model.Id is not null;
    ViewData["Title"] = (editing ? "Edit " : "New ") + meta.Singular;
    var lookups = Model.Lookups ?? new LookupSet();
    var dateMin = TrackerRules.MinDate.ToString("yyyy-MM-dd");
    var dateMax = TrackerRules.MaxDate.ToString("yyyy-MM-dd");
    var pipeline = isBr ? RequestValidation.PipelineFields : RequestValidation.IncidentPipelineFields;
}

@{
    async Task LookupSelect(string name, string lookupKey, int? selected, string label, bool quickAdd, string? dependsOn = null)
    {
        <div class="col-md-6 col-lg-4">
            <label class="form-label" for="@name">@label</label>
            <div class="input-group">
                <select class="form-select" id="@name" name="@name" data-lookup="@lookupKey" data-depends-on="@dependsOn">
                    <option value="">— Select —</option>
                    @foreach (var item in lookups.Of(lookupKey))
                    {
                        <option value="@item.Id" selected="@(item.Id == selected)">@item.Name</option>
                    }
                </select>
                @if (quickAdd && User.CanWrite())
                {
                    <button type="button" class="btn btn-outline-secondary" data-quick-add="@lookupKey" data-target="@name" title="Add a new @label.ToLowerInvariant()" aria-label="Add a new @label.ToLowerInvariant()">+</button>
                }
            </div>
        </div>
    }

    void DateInput(string name, string label, string? value, string? dependsOn = null, bool pipelineDate = false)
    {
        <div class="col-sm-6 col-lg-3">
            <label class="form-label" for="@name">@label</label>
            <input type="date" class="form-control @(pipelineDate ? "pipeline-date" : "")" id="@name" name="@name" value="@value" min="@dateMin" max="@dateMax" data-depends-on="@dependsOn" data-label="@label" />
        </div>
    }

    string? DateValue(string key) => key switch
    {
        "analysis_planned_start_date" => Model.AnalysisPlannedStartDate,
        "analysis_planned_end_date" => Model.AnalysisPlannedEndDate,
        "dev_planned_start_date" => Model.DevPlannedStartDate,
        "dev_planned_end_date" => Model.DevPlannedEndDate,
        "qa_planned_start_date" => Model.QaPlannedStartDate,
        "qa_planned_end_date" => Model.QaPlannedEndDate,
        "uat_planned_start_date" => Model.UatPlannedStartDate,
        "uat_planned_date" => Model.UatPlannedDate,
        "cab_date" => Model.CabDate,
        _ => Model.DeploymentPlannedEndDate,
    };

    string PropName(string key) => key switch
    {
        "analysis_planned_start_date" => nameof(Model.AnalysisPlannedStartDate),
        "analysis_planned_end_date" => nameof(Model.AnalysisPlannedEndDate),
        "dev_planned_start_date" => nameof(Model.DevPlannedStartDate),
        "dev_planned_end_date" => nameof(Model.DevPlannedEndDate),
        "qa_planned_start_date" => nameof(Model.QaPlannedStartDate),
        "qa_planned_end_date" => nameof(Model.QaPlannedEndDate),
        "uat_planned_start_date" => nameof(Model.UatPlannedStartDate),
        "uat_planned_date" => nameof(Model.UatPlannedDate),
        "cab_date" => nameof(Model.CabDate),
        _ => nameof(Model.DeploymentPlannedEndDate),
    };

    string? DependsOn(string key) => key.StartsWith("analysis") ? (isBr ? "BaRequired" : null) : "Estimated";
}

<div class="d-flex flex-wrap align-items-center justify-content-between gap-2 mb-3">
    <h1 class="h4 mb-0">@ViewData["Title"]</h1>
    @if (editing)
    {
        <div class="d-flex gap-2">
            <form method="post" asp-action="@(Model.IsFollowed ? "Unfollow" : "Follow")" asp-route-id="@Model.Id">
                <input type="hidden" name="returnUrl" value="@Url.Action("Edit", new { id = Model.Id })" />
                <button type="submit" class="btn btn-sm btn-outline-warning">@(Model.IsFollowed ? "\u2605 Following" : "\u2606 Follow")</button>
            </form>
            <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">View details</a>
        </div>
    }
</div>

<partial name="_Errors" />
<div id="dateErrors" class="alert alert-danger d-none" role="alert" aria-live="polite"></div>

<form method="post" asp-action="@(editing ? "Edit" : "Create")" asp-route-id="@Model.Id" id="requestForm" novalidate data-pipeline-form>
    <input type="hidden" name="Kind" value="@Model.Kind" />

    <fieldset class="card shadow-sm mb-3">
        <legend class="card-header h6 mb-0">Basic information</legend>
        <div class="card-body row g-3">
            <div class="col-md-6 col-lg-4">
                <label class="form-label" asp-for="RefNo">@meta.RefLabel</label>
                <input class="form-control" asp-for="RefNo" maxlength="255" />
            </div>
            <div class="col-md-6 col-lg-4">
                <label class="form-label" asp-for="Cr">CR</label>
                <input class="form-control" asp-for="Cr" maxlength="255" />
            </div>
            @if (isBr)
            {
                <div class="col-md-6 col-lg-4">
                    <label class="form-label" for="SubmissionDate">Submission Date</label>
                    <input type="date" class="form-control" id="SubmissionDate" name="SubmissionDate" value="@Model.SubmissionDate" min="@dateMin" max="@dateMax" />
                </div>
            }
            @{ await LookupSelect("BusinessUnitId", "business-units", Model.BusinessUnitId, "Business Unit", true); }
            @{ await LookupSelect("RequesterId", "requesters", Model.RequesterId, "Requester", true); }
            <div class="col-12">
                <label class="form-label" asp-for="Title">Title <span class="text-danger" aria-hidden="true">*</span></label>
                <textarea class="form-control" asp-for="Title" rows="2" maxlength="1000" required aria-required="true"></textarea>
            </div>
            <div class="col-12">
                <label class="form-label" asp-for="Description">Description</label>
                <textarea class="form-control" asp-for="Description" rows="4"></textarea>
            </div>
        </div>
    </fieldset>

    <fieldset class="card shadow-sm mb-3">
        <legend class="card-header h6 mb-0">Classification</legend>
        <div class="card-body row g-3">
            @{ await LookupSelect("PriorityId", "priorities", Model.PriorityId, "Priority", false); }
            @{ await LookupSelect("StageId", "stages", Model.StageId, "Stage", false); }
            @{ await LookupSelect("StatusId", "statuses", Model.StatusId, "Status", false); }
            @if (isBr)
            {
                await LookupSelect("BusinessCategoryId", "business-categories", Model.BusinessCategoryId, "Business Category", true);
            }
            <div class="col-md-6 col-lg-4">
                <label class="form-label" for="SystemIds">System</label>
                <select class="form-select" id="SystemIds" name="SystemIds" multiple size="5" data-lookup="systems" aria-describedby="systemHelp">
                    @foreach (var item in lookups.Of("systems"))
                    {
                        <option value="@item.Id" selected="@Model.SystemIds.Contains(item.Id)">@item.Name</option>
                    }
                </select>
                <div class="form-text" id="systemHelp">Ctrl/⌘-click to select several.</div>
            </div>
        </div>
    </fieldset>

    <fieldset class="card shadow-sm mb-3">
        <legend class="card-header h6 mb-0">Flags and ownership</legend>
        <div class="card-body row g-3">
            <div class="col-12 d-flex flex-wrap gap-4">
                <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="NewgenRelated" /><label class="form-check-label" asp-for="NewgenRelated">Newgen Related</label></div>
                <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="Estimated" data-controls /><label class="form-check-label" asp-for="Estimated">Estimated</label></div>
                @if (isBr)
                {
                    <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="BaRequired" data-controls /><label class="form-check-label" asp-for="BaRequired">BA Required</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="BrdAssigned" /><label class="form-check-label" asp-for="BrdAssigned">BRD Assigned</label></div>
                    <div class="form-check"><input class="form-check-input" type="checkbox" asp-for="Regulatory" data-controls /><label class="form-check-label" asp-for="Regulatory">Regulatory</label></div>
                }
            </div>
            <div class="col-md-6 col-lg-4">
                <label class="form-label" for="TechOwnerIds">Tech Owner</label>
                <select class="form-select" id="TechOwnerIds" name="TechOwnerIds" multiple size="5" data-lookup="tech-owners" aria-describedby="ownerHelp">
                    @foreach (var item in lookups.Of("tech-owners"))
                    {
                        <option value="@item.Id" selected="@Model.TechOwnerIds.Contains(item.Id)">@item.Name</option>
                    }
                </select>
                <div class="form-text" id="ownerHelp">The first selected owner is kept as the primary owner.</div>
            </div>
            @{ await LookupSelect("RmId", "rms", Model.RmId, "RM", true); }
            @if (isBr)
            {
                await LookupSelect("RegulatorId", "regulators", Model.RegulatorId, "Regulator", true, "Regulatory");
                DateInput("RegulatoryDeadline", "Regulatory Deadline", Model.RegulatoryDeadline, "Regulatory");
            }
        </div>
    </fieldset>

    <fieldset class="card shadow-sm mb-3">
        <legend class="card-header h6 mb-0">Pipeline dates</legend>
        <div class="card-body row g-3">
            @foreach (var f in pipeline)
            {
                DateInput(PropName(f.Key), f.Label, DateValue(f.Key), DependsOn(f.Key), pipelineDate: true);
            }
            @{ DateInput("ClosedDate", "Closed Date", Model.ClosedDate); }
        </div>
    </fieldset>

    <div class="d-flex flex-wrap gap-2 sticky-bottom bg-body py-2 border-top">
        <button type="submit" class="btn btn-primary">Save</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
    </div>
</form>

@if (editing && User.CanWrite())
{
    <form method="post" asp-action="Delete" asp-route-id="@Model.Id" class="mt-3" data-confirm="Delete this @(meta.IsIncident ? "incident" : "business request")? This cannot be undone.">
        <button type="submit" class="btn btn-outline-danger">Delete</button>
    </form>
}

