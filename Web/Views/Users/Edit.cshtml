@model UserEditViewModel
@{
    ViewData["Title"] = "Edit user";
}
<div class="row"><div class="col-md-6 col-lg-4">
<h1 class="h4 mb-3">Edit user <span class="text-muted">@Model.Username</span></h1>
<partial name="_Errors" />
<form method="post" asp-action="Edit" asp-route-id="@Model.Id" novalidate>
    <input type="hidden" asp-for="Username" />
    <div class="mb-3"><label class="form-label" asp-for="Name"></label><input class="form-control" asp-for="Name" maxlength="200" required /></div>
    <div class="mb-3">
        <label class="form-label" asp-for="Role"></label>
        <select class="form-select" asp-for="Role">
            <option value="@AppRoles.ReadOnly">Read Only</option>
            <option value="@AppRoles.ReadWrite">Read/Write</option>
        </select>
    </div>
    <div class="form-check mb-3"><input class="form-check-input" asp-for="IsActive" /><label class="form-check-label" asp-for="IsActive">Active</label></div>
    <div class="mb-3"><label class="form-label" asp-for="Password"></label><input class="form-control" asp-for="Password" minlength="6" autocomplete="new-password" /></div>
    <div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">Cancel</a><button type="submit" class="btn btn-primary">Save</button></div>
</form>
</div></div>
