@model UsersIndexViewModel
@inject DisplayFormatter Format
@{
    ViewData["Title"] = "Users";
}
<div class="d-flex align-items-center justify-content-between mb-3">
    <h1 class="h4 mb-0">Users</h1>
    <a class="btn btn-sm btn-primary" asp-action="Create">+ New user</a>
</div>
<div class="table-responsive">
    <table class="table table-sm table-hover align-middle">
        <thead class="table-light"><tr><th>Username</th><th>Name</th><th>Role</th><th>Active</th><th>Created</th><th><span class="visually-hidden">Actions</span></th></tr></thead>
        <tbody>
            @foreach (var u in Model.Users)
            {
                <tr>
                    <td>@u.Username</td>
                    <td>@u.Name</td>
                    <td>@(u.Role == AppRoles.ReadWrite ? "Read/Write" : "Read Only")</td>
                    <td><span class="badge @(u.IsActive ? "text-bg-success" : "text-bg-secondary")">@(u.IsActive ? "Active" : "Inactive")</span></td>
                    <td><time class="js-local" datetime="@DisplayFormatter.Iso(u.CreatedAt)">@Format.DateTime(u.CreatedAt)</time></td>
                    <td class="text-nowrap">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@u.Id">Edit</a>
                        @if (u.Id != Model.CurrentUserId)
                        {
                            <form method="post" asp-action="Delete" asp-route-id="@u.Id" class="d-inline" data-confirm="Delete user &quot;@u.Username&quot;? Their follow-ups are removed too.">
                                <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
