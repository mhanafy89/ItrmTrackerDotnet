@{
    var signedIn = User.Identity?.IsAuthenticated == true;
    var canWrite = User.CanWrite();
    var controller = ViewContext.RouteData.Values["controller"]?.ToString();
    var action = ViewContext.RouteData.Values["action"]?.ToString();
    string Active(string c, string? a = null) => string.Equals(controller, c, StringComparison.OrdinalIgnoreCase) && (a is null || string.Equals(action, a, StringComparison.OrdinalIgnoreCase)) ? "active" : "";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] is string t ? t + " – " : "")ITRM Tracker</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="icon" href="~/favicon.ico" />
</head>
<body class="@(signedIn && !canWrite ? "read-only" : "")">
    <a class="visually-hidden-focusable btn btn-light position-absolute m-1" href="#main">Skip to content</a>
    <div id="dbBanner" class="alert alert-danger rounded-0 mb-0 text-center d-none" role="alert" aria-live="assertive">
        Connection to the database was lost. Retrying every 20 seconds&hellip;
    </div>
    <header>
        <nav class="navbar navbar-expand-xl navbar-dark bg-itrm" aria-label="Main navigation">
            <div class="container-fluid">
                <a class="navbar-brand d-flex flex-column lh-sm" asp-controller="Home" asp-action="Index">
                    <span class="small text-white-50">ITRM Operations</span>
                    <span class="fw-semibold">Business Request Tracker</span>
                </a>
                @if (signedIn)
                {
                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
                        <span class="navbar-toggler-icon"></span>
                    </button>
                    <div class="collapse navbar-collapse" id="mainNav">
                        <ul class="navbar-nav me-auto">
                            <li class="nav-item"><a class="nav-link @Active("Home", "Index")" asp-controller="Home" asp-action="Index">Dashboard</a></li>
                            <li class="nav-item"><a class="nav-link @Active("StageSla")" asp-controller="StageSla" asp-action="Index">Stage SLA</a></li>
                            <li class="nav-item"><a class="nav-link @Active("BusinessRequests")" asp-controller="BusinessRequests" asp-action="Index">Business Requests</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Incidents")" asp-controller="Incidents" asp-action="Index">Incidents</a></li>
                            <li class="nav-item"><a class="nav-link @Active("FollowUp", "Index")" asp-controller="FollowUp" asp-action="Index">Follow-up</a></li>
                            <li class="nav-item"><a class="nav-link @Active("FollowUp", "Mine")" asp-controller="FollowUp" asp-action="Mine">My Follow-ups</a></li>
                            <li class="nav-item"><a class="nav-link @Active("Query")" asp-controller="Query" asp-action="Index">Query</a></li>
                        </ul>
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            @if (canWrite)
                            {
                                <a class="btn btn-sm btn-outline-light" asp-controller="Import" asp-action="Index">Import &amp; Merge</a>
                                <a class="btn btn-sm btn-outline-light" asp-controller="Lookups" asp-action="Index">Manage Lookups</a>
                                <a class="btn btn-sm btn-outline-light" asp-controller="SlaSettings" asp-action="Index">SLA Settings</a>
                                <a class="btn btn-sm btn-outline-light" asp-controller="Users" asp-action="Index">Users</a>
                            }
                            <div class="dropdown">
                                <button class="btn btn-sm btn-light dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    @User.DisplayName() <span class="text-muted">(@(canWrite ? "Read/Write" : "Read Only"))</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><a class="dropdown-item" asp-controller="Account" asp-action="ChangePassword">Change Password</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    <li>
                                        <form method="post" asp-controller="Account" asp-action="Logout">
                                            <button type="submit" class="dropdown-item">Log out</button>
                                        </form>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </nav>
    </header>
    <main id="main" class="container-fluid py-3" tabindex="-1">
        <partial name="_Alerts" />
        @RenderBody()
    </main>
    <footer class="border-top text-muted small py-2 px-3">ITRM Tracker &middot; ASP.NET Core edition</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
