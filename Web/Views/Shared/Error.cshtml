@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-body">
                <h1 class="h4">@(Model.StatusCode == 404 ? "Not found" : Model.StatusCode == 403 ? "Access denied" : "Something went wrong")</h1>
                <p>@Model.Message</p>
                @if (!string.IsNullOrEmpty(Model.TraceId))
                {
                    <p class="small text-muted mb-0">Reference: <code>@Model.TraceId</code></p>
                }
                <a class="btn btn-primary mt-3" asp-controller="Home" asp-action="Index">Back to the dashboard</a>
            </div>
        </div>
    </div>
</div>
