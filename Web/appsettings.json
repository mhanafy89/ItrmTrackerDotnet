{
  "ConnectionStrings": {
    "ItrmDatabase": "Server=localhost;Database=itrm_tracker;Integrated Security=true;Encrypt=true;TrustServerCertificate=false;Application Name=ITRM Tracker",
    "QueryConsole": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedOnStartup": true,
    "SeedAdminUsername": "admin",
    "SeedAdminPassword": ""
  },
  "Security": {
    "PasswordHashFormat": "Identity",
    "UpgradeLegacyHashesOnLogin": true,
    "SessionDays": 7,
    "CookieSecurePolicy": "SameAsRequest"
  },
  "Sla": {
    "EngineSyncEnabled": true,
    "BackfillOnStartup": true,
    "BusinessTimeZoneId": ""
  },
  "QueryConsole": {
    "BlockedTables": [ "users", "sessions" ],
    "MaxRows": 10000,
    "CommandTimeoutSeconds": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "ItrmTracker.Audit": "Information"
    }
  },
  "AllowedHosts": "*"
}
